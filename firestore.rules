rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /meters/{id} {
      allow read, write: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if request.auth != null;
      // ضع بريد المسؤول بدل المثال
      allow write: if request.auth != null && request.auth.token.email == 'ضع-بريدك-هنا@example.com';
    }
  }
}
